# ThreadRunner Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file.

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Authorization (use immutable Slack IDs, not names).
# ALLOWED_USER_IDS must contain exactly one ID: startup refuses zero or several.
ALLOWED_TEAM_ID=T0123456789
ALLOWED_USER_IDS=U01YOURUSERID
ALLOWED_CHANNEL_IDS=C01PRIVATECONTROL

# Runner Configuration (read-only Codex runs)
# Exactly ONE absolute repository root. It is canonicalized (realpath) at startup, and startup
# refuses zero, several, relative (including ~), missing, or non-directory values. It must not
# contain the database file. It comes from here only, never from Slack text.
APPROVED_REPO_ROOTS=/home/user/code/your-project
# Absolute path to the Codex CLI (run `which codex`). It is not looked up through PATH, and it
# must not live inside the repository above.
CODEX_BIN=/home/you/.local/bin/codex
# Optional wall-clock limit for one run, 10 to 3600 seconds (default 600).
# RUNNER_TIMEOUT_SECONDS=600
# Only these values are accepted for now; anything else refuses to start.
RUNNER_CONCURRENCY=1
RUNNER_DEFAULT_MODE=read_only

# Provider flags are not configurable. A non-empty CODEX_FLAGS refuses to start, so a bypass
# flag cannot be added by configuration. Never set: --dangerously-bypass-approvals-and-sandbox, --yolo.
CODEX_FLAGS=
CLAUDE_FLAGS=

# Database (SQLite). Use an ABSOLUTE path outside any git repository.
# The store creates the directory as 0700 and the file as 0600, and refuses
# in-repo, relative, symlinked, or group/world-accessible locations.
DATABASE_PATH=/home/you/.threadrunner/threadrunner.db

# Server
PORT=8877
# NEVER bind to 0.0.0.0 or expose outside loopback
HOST=127.0.0.1
